# WHOOP-Anbindung – Kopie als .env anlegen und ausfüllen. Die .env bleibt lokal (steht in .gitignore).
# Client-ID und Secret kommen aus deiner App auf https://developer.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Ordner, in dem whoop.json (Klartext, privat) abgelegt wird – z.B. der OneDrive-Ordner neben mein-plan.json
WHOOP_DATEN_ORDNER=
# Passwortdatei des Plans (PLAN-PASSWORT.txt). Wenn gesetzt, wird zusätzlich whoop.enc.json für die App erzeugt.
WHOOP_PASSWORT_DATEI=
